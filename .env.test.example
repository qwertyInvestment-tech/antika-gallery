# Optional isolated test database. Copy to `.env.test` and create the database
# with a non-destructive `CREATE DATABASE antika_test` when you are ready.
# Do not run migrate reset against the development `antika` database.
#
# npm test currently loads `.env` (shared development DB) unless `.env.test` exists.
# ReferenceCounter increments in that shared DB; that is expected until isolation
# is enabled.

NODE_ENV=test
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://antika:antika@localhost:5433/antika_test?schema=public
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
STORAGE_PROVIDER=LOCAL
STORAGE_LOCAL_DIR=./storage
STORAGE_PUBLIC_BASE_URL=/api/media

# Optional social login (leave empty in tests unless exercising live OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
