# Environment — never commit real secrets.
# Copy this file to `.env` for local development.

NODE_ENV=development
# Public origin used for canonical URLs, sitemap, Open Graph.
# Production: set to the real HTTPS origin (do not leave localhost).
APP_URL=http://localhost:3000

# Isolated Postgres for ANTIKA (port 5433 — does not use other local databases)
DATABASE_URL=postgresql://antika:antika@localhost:5433/antika?schema=public

# HMAC secret for signed session cookies (min 32 characters).
# Production: use a unique random value. Never ship the placeholder below.
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Initial SUPER_ADMIN created by prisma seed
BOOTSTRAP_ADMIN_EMAIL=admin@antika.mk
BOOTSTRAP_ADMIN_PASSWORD=change-me-now
BOOTSTRAP_ADMIN_NAME=Администратор

# Object storage (LOCAL now; S3/R2 later without schema change)
STORAGE_PROVIDER=LOCAL
STORAGE_LOCAL_DIR=./storage
# Same-origin media route. Do not set an absolute localhost URL — images are
# served from /api/media regardless of the process port (dev, :3006, Vercel).
STORAGE_PUBLIC_BASE_URL=/api/media

# Customer social login (optional). Leave empty to hide Google/Facebook buttons.
# Google OAuth requires provider configuration in Google Cloud Console.
# Redirect URI: {APP_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facebook Login requires provider configuration in Meta Developer Console.
# Redirect URI: {APP_URL}/api/auth/oauth/facebook/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
